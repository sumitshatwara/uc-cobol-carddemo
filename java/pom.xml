<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.carddemo</groupId>
  <artifactId>carddemo-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>CardDemo Java 21 target</name>
  <description>Java 21 / Spring Batch / PostgreSQL conversion of the CardDemo batch estate.</description>

  <!--
    One module per slice.  Slices own only their module; java/common and java/app
    belong to the foundation.  A slice module that implements batch chains lists
    them, one per line, in java/<module>/parity-chains (read by `make parity-java`).
  -->
  <modules>
    <module>common</module>
    <module>posting</module>
    <module>interest</module>
    <module>trantype</module>
    <module>online</module>
    <module>app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-common</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- one report line per test so BR ids show up in the test report -->
            <reportFormat>plain</reportFormat>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
